NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
MQTT_HOST=localhost
MQTT_PORT=1883

OPENAI_API_KEY=sk-...
# Pick current models from https://platform.openai.com/docs/pricing
OPENAI_ORCHESTRATOR_MODEL=   # capable, tool-calling model (mini tier is usually enough)
OPENAI_CYPHER_MODEL=         # best accuracy you can afford; Cypher quality matters most
OPENAI_ANSWER_MODEL=         # mini tier
OPENAI_CHEAP_MODEL=          # nano tier: doc generation, proactive messages
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# reasoning models: low/medium/high/none. Lower = faster and cheaper; empty = parameter not sent
OPENAI_REASONING_EFFORT=
# USD per 1M tokens, used for cost estimates in traces
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=

# similarity cutoff, (1+cos)/2. Calibrated on the generated corpus: off-topic <= 0.64, on-topic >= 0.70
RAG_MIN_SCORE=0.68
SIM_SPEED=0.5

# run the MQTT consumer + alarm engine inside the API process (0 = off)
ENABLE_STREAMING=1
